---
// `/` and `/en/`: the price table. Data comes only from data/ through @tldcost/core (concept
// section 3.4); the footnotes are built in the page language (Archiv-Issue 33).
import { LOCALES, type Lang } from '../i18n';
import { buildPayload } from '../lib/rows';
import { siteData, siteHistory } from '../lib/site-data';
import Layout from '../layouts/Layout.astro';
import PriceTableDe from './PriceTableDe';
import PriceTableEn from './PriceTableEn';
import SuggestProvider from './SuggestProvider.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = LOCALES[lang];
const t = L.s.pages.index;
const json = JSON.stringify(buildPayload(siteData(), { locale: L, history: siteHistory() }));
---

<Layout footnotes title={t.title} description={t.description} other={lang === 'de' ? '/en/' : '/'}>
  <h1>{t.h1}</h1>
  {lang === 'de' ? <PriceTableDe client:load data={json} /> : <PriceTableEn client:load data={json} />}
  <SuggestProvider lang={lang} />
  <noscript>
    <p class="noscript">{t.noscript}</p>
  </noscript>
</Layout>
