{
  "name": "@tldcost/mcp",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "MCP server (stdio) for the public tldcost.io domain price data",
  "type": "module",
  "bin": {
    "tldcost-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tldcost/core": "*"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
